{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "routone-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["routone.api.app:app", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "routone-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev", "--", "--port", "5173", "--host", "127.0.0.1"],
      "port": 5173
    }
  ]
}
